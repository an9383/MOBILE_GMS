    <link rel="stylesheet" href="~/css/gms_01.css" />
    <script src="~/Content/Login_v2/vendor/jquery/jquery-3.2.1.min.js"></script>
</environment>

<style>
    th, td {
        text-align: center;
    }
</style>

<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <form class="form-horizontal">
                        <div class="card-header">
                            <h4 class="card-title">
                                피 킹
                                <input type="hidden" id="init_cell_cd" value="@ViewData["barcode"]" />
                            </h4>
                        </div>

                        <div class="card-content">


                            <!-- 페이징 처리 필요 변수 -->
                            <input type="hidden" id="list_count" name="list_count" />
                            <input type="hidden" id="current_page" name="current_page" />
                            <input type="hidden" id="page_limit" name="page_limit" />
                            <input type="hidden" id="max_page" name="max_page" />
                            <input type="hidden" id="start_page" name="start_page" />
                            <input type="hidden" id="end_page" name="end_page" />
                            <input type="hidden" id="board_limit" name="board_limit" />


                            <fieldset>
                                <div class="form-group">
                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">위치코드</span>

                                            <span id="mobile_object" style="display:none">

                                                <input type="text" placeholder="위치코드" class="form-control" id="area_cd" name="mobile_object" readonly="readonly" />

                                            </span>
                                            <span id="pc_object" style="display:none">

                                                <input type="text" placeholder="위치코드" class="form-control" id="area_cd" name="pc_object" onkeydown="onKeyDown();" onfocus="setBarcodeInit()" />

                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-7">
                                        <div class="input-group">
                                            <span class="input-group-addon">위치명</span>
                                            <input type="text" placeholder="위치명" class="form-control" id="area_nm" name="area_nm" readonly="readonly">
                                            <span class="input-group-addon"><button class="btn btn-success btn-xs" id="btn_int" type="button" onclick="javascript:fn_init();">초기화</button></span>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <div class="col-sm-12">
                                        <hr />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="table-responsive table-full-width max-h-315 h-50">
                                    <table id="dataList" class="table table-hover w-s-nr">
                                        <thead style="background: #4EAE51; color: white;">
                                        <th style="width: 5%;"><input type="checkbox" style="width:20px;height:20px;" id="allCheck" /></th>
                                        <th>바코드</th>
                                        <th>품목명</th>
                                        <th>시험번호</th>
                                        <th>품목코드</th>
                                        <th>재고량</th>
                                        </thead>

                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>

                            <fieldset style="text-align: center">
                                <ul class="pagination">
                                </ul>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <div class="col-sm-12">
                                        <hr />
                                        <!--
                                        <button type="button" class="btn-gms btn-gms-info btn-fill pull-right" disabled="disabled" style="border-radius: 25px;" onclick="fn_stackPack()">적 치</button>
                                        <button type="submit" class="btn-gms btn-gms-info btn-fill pull-right" style="border-radius: 25px;">피 킹</button>
                                        -->
                                        <button id="btn_pick" type="button" class="btn btn-default btn-lg pull-right" disabled="disabled" onclick="javascript:fn_pickPack()">피 킹</button>
                                    </div>
                                </div>
                            </fieldset>

                        </div>
                    </form>
                </div>  <!-- end card -->
            </div> <!-- end col-md-12 -->
        </div> <!-- end row -->
    </div>

</div>

<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/jquery/jquery-3.2.1.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/bootstrap/js/popper.js"></script>
<script src="~/Content/Table_Fixed_Header/vendor/bootstrap/js/bootstrap.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/select2/select2.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/js/main.js"></script>


<script type="text/javascript">
    $(function () {

        // 모바일 기기 체크
        fn_moblieCK();

        //전체선택 체크박스 클릭
        $("#allCheck").click(function () {
            //만약 전체 선택 체크박스가 체크된상태일경우
            if ($("#allCheck").prop("checked")) {
                //해당화면에 전체 checkbox들을 체크해준다
                $("input[type=checkbox]").prop("checked", true);
                // 전체선택 체크박스가 해제된 경우
            } else {
                //해당화면에 모든 checkbox들의 체크를해제시킨다.
                $("input[type=checkbox]").prop("checked", false);
            }
            fn_trCheckCount();
        });

        if ($('#init_cell_cd').val() && $('#init_cell_cd').val() != '') {

            var params = {
                'barcode': $('#init_cell_cd').val()
            }

            fn_callBarcodeInfo(params);

        }

        if (screen.height > 640) {
            $("#dataList").parent().removeClass("max-h-315");
            $("#dataList").parent().addClass("max-h-650");
        }

        // 테이블 resize 핸들러
        resize_table();

        var checkWeb = fn_mobile_ckeck();
        if (checkWeb == "web") {
            $("div.table-responsive.table-full-width").css("overflow-x", "auto");
            resize_Web_table("dataList", 650);
        }
    })

    // 바코드 초기화 (웹 환경에서 사용됨)
    function setBarcodeInit() {

        $('#area_cd').val('');

    }

    // 엔터키 동작 (웹 환경에서 사용됨)
    function onKeyDown() {

        // 엔터키 코드
        if (event.keyCode == 13) {

            var barcode = $("#area_cd").val();

            // 포커스 해제
            $("#area_cd").blur();

            fn_callBarcodeInfo({ 'barcode': barcode.replaceAll("\0", "") });

        }

    }

    /*
     * 바코드관련 상세 정보 호출
     */
    function fn_callBarcodeInfo(params) {

        // 스캔한 바코드 셋팅
        //$("#barcode_val").val(params.barcode);
        var barcode_gubun = fn_getBarcodePrefix(params.barcode);


        //창고 바코드(팔레트에 적치된 팩정보조회)
        if (barcode_gubun == "W") {
            $("#locArea").text("창고");
            fn_selectPack('SelectWorkroom', params);
        }
        //존 바코드(팔레트에 적치된 팩정보조회)
        else if (barcode_gubun == "Z") {
            $("#locArea").text("구역");
            fn_selectPack('SelectZone', params);

        }
        //셀 바코드( 팔레트에 적치된 팩정보조회)
        else if (barcode_gubun == "C") {
            $("#locArea").text("셀");
            fn_selectPack('SelectCell', params);

        }
        //팔레트 바코드 (1.위치 유무 확인 , 2.위치에 적치된 팩인지 확인 , 2-1.적치된 팩이면 위치로 이동 , 2-2.적치안된 팩이면 경고)
        else if (barcode_gubun == "L") {
            // 기존 PDA 소스에 구현 로직 없음( 주석 처리됨)
        }
        //팩 바코드
        else if (barcode_gubun == "P" || barcode_gubun == "G") {

            // 1.위치 바코드 존재 여부 확인( 후 팩/지함 정보 호출 )
            var area_cd = $.trim($("#area_cd").val());
            if (typeof area_cd == "undefined" || area_cd == null || area_cd == "") {

                swal({
                    title: '피킹할 위치 바코드를 먼저 스캔해주세요.',
                    //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                    type: 'error'
                    //timer: 1000
                }
                );
                return;
            }

            // 2.팩/지함 정보 호출
            var table = $("#dataList > tbody");
            var barcodeNotMatchCnt = 0;     // 바코드 스캔한 정보가 해당 table에 없는 갯수
            table.find('tr').each(function (key, val) {

                var $tds = $(this).find('td');
                var _barcode = $tds.eq(1).text();
                if (_barcode == params.barcode) {
                    $('input:checkbox[id="ck_' + _barcode + '"]').prop("checked", true);
                    fn_trCheckCount();

                } else {
                    barcodeNotMatchCnt++;
                }
            });

            //없는 팩/지함 정보 추가(신규)
            if ($("#dataList > tbody tr").length == barcodeNotMatchCnt) {
                // 피킹 리스트에 추가
                if (barcode_gubun == "P") {
                    fn_addPack('SelectPickPackInfo', params);

                } else if (barcode_gubun == "G") {
                    fn_addPack('SelectPickBoxInfo', params);

                }
            }
        }

    }

    /*
     * 없는 팩/지함 정보 추가(신규)
     */
    function fn_addPack(actionName, params) {

        if (confirm("피킹 리스트에 추가하시겠습니까?")) {

            var callUrl = "/Picking/" + actionName;
            var request = JSON.stringify(params);
            $.ajax({
                method: "POST",
                data: request,
                url: callUrl,
                dataType: 'json',
                contentType: 'application/json; charset=UTF-8',
                success: function (result) {

                    var list_count = parseInt($("#list_count").val() != 1 ? $("#list_count").val() : 1); // 모든 목록의 수
                    var current_page = parseInt($("#current_page").val() != 1 ? $("#current_page").val() : 1);// 현재 페이지
                    var max_page = parseInt($("#max_page").val());  // 전체 페이지의 가장 마지막 페이지
                    var board_limit = parseInt($("#board_limit").val());  // 한 페이지에 보여질 게시
                    var page_limit = parseInt($("#page_limit").val());; // 한 페이지 하단에 보여질 페이지 수

                    $("#list_count").val(list_count + 1);

                    if (list_count >= board_limit * max_page) {
                        $("#current_page").val(current_page + 1);
                    }

                    var max_first_num = ((max_page - 1) / page_limit) * page_limit + 1;
                    if (board_limit * max_page <= list_count && max_first_num > current_page) {
                        $("#current_page").val(max_first_num + 1);
                    }

                    if (max_page > current_page && list_count < (board_limit * max_page)) {
                        $("#current_page").val(max_page);
                    }


                    if (typeof result.pack_barcode == "undefined" || result.pack_barcode == null || result.pack_barcode == "" || result.pack_barcode == "null") {
                        swal({
                            title: '등록되지 않은 바코드 입니다. 바코드를 확인해주시기 바랍니다.',
                            //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                            type: 'error'
                            //timer: 1000
                        });
                    } else {
                        //피킹 리스트 테이블 셋팅
                        fn_pickingTableSet(result, 'Y');
                        fn_trCheckCount();



                        // 테이블 resize
                        resize_table();

                        // 페이징 처리
                        pagination();

                        // 목록 추가 시 페이징 변경
                        fn_go_page();
                    }
                },
                error: function (data) {
                    alert('error' + data.status);
                }
            });
        } else {
            return;
        }
    }

    /*
     * checkbox 체크 갯수에 따른 피킹 버튼 활성/비활성화 처리.
     */
    function fn_trCheckCount() {

        var checkCnt = 0;
        var table = $("#dataList > tbody");
        table.find('tr').each(function (key, val) {
            var $tds = $(this).find('td');
            var _barcode = $tds.eq(1).text();
            if ($('input:checkbox[id="ck_' + _barcode + '"]').is(":checked")) {
                checkCnt++;
            }
        });

        if (checkCnt > 0) {
            fn_setEnabledObj('btn_pick', 'btn-default', 'btn-primary', false);
        } else {
            fn_setEnabledObj('btn_pick', 'btn-default', 'btn-primary', true);
        }
    }

    /*
     * 창고 or 구역 or 셀 정보 표출
     */
    function fn_selectPack(actionName, params) {

        // 그리드 초기화
        $('#dataList > tbody').empty();
        // 피킹 버튼 비활성화
        fn_setEnabledObj('btn_pick', 'btn-default', 'btn-primary', true);

        var callUrl = "/Picking/" + actionName;
        var request = JSON.stringify(params);
        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (result) {
                var json = JSON.parse(result);
                var loc = json.Table;       // 위치 정보 테이블
                var data = json.Table1;     // 피킹 리스트 테이블

                $("#area_cd").val(loc[0].area_cd);
                $("#area_nm").val(loc[0].area_nm);
                $("#list_count").val(data.length);
                $("#current_page").val(1);

                for (var i = 0; i < data.length; i++) {

                    //피킹 리스트 테이블 셋팅
                    fn_pickingTableSet(data[i], 'N');

                }
                // 테이블 resize
                resize_table();

                // 페이징 처리
                pagination();

            },
            error: function (data) {
                alert('error' + data.status);
            }
        });
    }

    /*
     * 피킹 리스트 테이블 셋팅 함수
     */
    function fn_pickingTableSet(data, ischeck) {

        var checked = "";
        if (ischeck == "Y") {
            checked = "checked='checked'";
        }

        var ck = data.ck;                //피킹(체크 확인)
        var pack_barcode = data.pack_barcode;        //바코드
        var item_nm = data.item_nm;          //품목명
        var test_no = data.test_no;          //시험번호
        var item_cd = data.item_cd;          //품목코드
        var remain_qty = data.receipt_pack_remain_qty;      // 재고량

        $('#dataList > tbody').append(
            '<tr><td style="width: 5%;"><input type="checkbox" ' + checked + ' id="ck_' + pack_barcode + '" value="' + pack_barcode + '" onchange="javascript:fn_trCheckCount();" style="width:20px;height:20px;" />' +
            '</td><td>' + pack_barcode +
            '</td><td>' + item_nm +
            '</td><td>' + test_no +
            '</td><td>' + item_cd +
            '</td><td>' + remain_qty +
            '</td></tr>');

    }


    /*
     *  팩/지함 피킹 처리
     */
    function fn_pickPack() {

        // 웹 환경에선 적치/피킹 기능 제외 (테블릿 조회 목적)
        if (document.getElementById('pc_object') && document.getElementById('pc_object').style.display === 'block') {
            swal({
                title: '웹 환경에선 적치/피킹 기능이 제한 됩니다.',
                type: 'info'
            });
            return;
        }

        var controllerName = "Picking";
        var actionName = '';
        var successcnt = 0;

        if (confirm("피킹 하시겠습니까?")) {

            var table = $("#dataList > tbody");
            table.find('tr').each(function (key, val) {
                var $tds = $(this).find('td');
                var barcode = $tds.eq(1).text();
                if ($('input:checkbox[id="ck_' + barcode + '"]').is(":checked")) {

                    var preFix = barcode.substr(0, 1);
                    if (preFix == 'P') {        // 팩 바코드
                        actionName = 'PickPack';
                    } else if (preFix == 'G') { // 지함 바코드
                        actionName = 'PickBox';
                    } else if (preFix == 'L') { // 팔렛트 바코드
                        actionName = 'PickPallet';
                    }

                    var params = { 'barcode': barcode };
                    var callUrl = "/" + controllerName + "/" + actionName;

                    var request = JSON.stringify(params);
                    $.ajax({
                        method: "POST",
                        data: request,
                        url: callUrl,
                        async: false,
                        dataType: 'json',
                        contentType: 'application/json; charset=UTF-8',
                        success: function (data) {

                            if (data.result == '1') {
                                successcnt = successcnt + 1;
                            }
                        },
                        error: function (data) {
                            alert('error' + data.status);
                        }
                    });

                }
            });

            if (successcnt > 0) {

                swal({
                    //title: 'Success!',
                    title: '정상적으로 처리되었습니다.',
                    type: 'success'
                    //timer: 1000
                }
                ).then(
                    function () {
                        // 페이지 다시 로딩.
                        var barcode = $("#area_cd").val();
                        fn_callBarcodeInfo({ 'barcode': barcode });
                    }
                );
            }

        } else {
            return;
        }
    }



    /*
     * 필드 초기화
     */
    function fn_init(mode) {

        $("#area_cd").val('');
        $("#area_nm").val('');

        // 그리드 초기화
        $('#dataList > tbody').empty();
        // 피킹 버튼 비활성화
        fn_setEnabledObj('btn_pick', 'btn-default', 'btn-primary', true);

        resize_table();
    }

    function resize_table() {
        var count = $("#dataList tbody tr").length;
        var newHeight = 48 + (count * 45);

        $("#dataList").parent().removeClass("h-50");
        $("#dataList").parent().height(newHeight);
    }

</script>