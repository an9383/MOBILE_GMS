<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <div class="card-header">
                        <h4 class="card-title">
                            자재 품목별 재고량
                        </h4>
                    </div>

                    <div class="card-content">
                        <fieldset>
                            <form name="srch_form" id="srch_form">
                                <input type="hidden" id="gubun2" name="gubun2" value="" />
                                <input type="hidden" id="gubun" name="gubun" />
                                <input type="hidden" id="srchTitle" name="srchTitle" />

                                <!-- 페이징 처리 필요 변수 -->
                                <input type="hidden" id="list_count" name="list_count" />
                                <input type="hidden" id="current_page" name="current_page" />
                                <input type="hidden" id="page_limit" name="page_limit" />
                                <input type="hidden" id="max_page" name="max_page" />
                                <input type="hidden" id="start_page" name="start_page" />
                                <input type="hidden" id="end_page" name="end_page" />
                                <input type="hidden" id="board_limit" name="board_limit" />

                                <div class="form-group">
                                    <div class="col-sm-5">
                                        <div class="input-group" id="mobile_object">
                                            <span class="input-group-addon">품목코드</span>
                                            <input type="text" placeholder="품목코드 검색 입력" class="form-control item_cd" id="srch_cd1" name="srch_cd1" readonly="readonly">
                                            <span class="input-group-addon"><button class="btn btn-warning btn-xs btn-fill" id="btn_itemFind" type="button" onclick="javascript:fn_findItem('PDA_StockStatus2_P_item_Win','item_material_p','자재조회')"><span class="btn-label"><i class="ti-search"></i></span></button></span>
                                        </div>
                                    </div>

                                    <div class="form-group pull-left" style="padding-left: 5%;">
                                        <div class="checkbox">
                                            <input id="srch_check" name="srch_check" type="checkbox" checked="checked">
                                            <label for="checkbox15">
                                                사용 여부
                                            </label>
                                        </div>
                                    </div>

                                    <button id="btn_search" type="button" class="btn btn-info btn-fill pull-right" onclick="javascript:fn_search()">검색</button>

                                </div>

                            </form>
                        </fieldset>

                        <input type="hidden" value="테스트" id="testInput" />

                        <fieldset>
                            <div class="table-responsive table-full-width max-h-315 h-50">
                                <table id="srchList" class="table table-hover w-s-nr">
