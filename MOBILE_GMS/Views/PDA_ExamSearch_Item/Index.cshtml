@{
    ViewData["Title"] = "PDA_ExamSearch_Item";
    Layout = "~/Views/Shared/_GmsLayout.cshtml";
}

<!--===============================================================================================-->
<link rel="stylesheet" type="text/css" href="~/Content/Table_Fixed_Header/vendor/animate/animate.css">
<!--===============================================================================================-->
<link rel="stylesheet" type="text/css" href="~/Content/Table_Fixed_Header/vendor/select2/select2.min.css">
<!--===============================================================================================-->
<link rel="stylesheet" type="text/css" href="~/Content/Table_Fixed_Header/vendor/perfect-scrollbar/perfect-scrollbar.css">
<!--===============================================================================================-->
<link rel="stylesheet" type="text/css" href="~/Content/Table_Fixed_Header/css/util.css">
<link rel="stylesheet" type="text/css" href="~/Content/Table_Fixed_Header/css/main.css">
<!--===============================================================================================-->
<environment names="Development">
    <link rel="stylesheet" href="~/css/gms_01.css" />
    <script src="~/Content/Login_v2/vendor/jquery/jquery-3.2.1.min.js"></script>
</environment>

<style>
    th, td {
        text-align: center;
    }
</style>


<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <div class="card-header">
                        <h4 class="card-title">
                            시험번호 별 제품 위치 조회
                        </h4>
                    </div>
                    <div class="card-content">

                        <!--시험번호-->
                        <fieldset>
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="input-group">
                                        <span class="input-group-addon">시험번호</span>
                                        <input type="text" placeholder="시험번호를 입력해주세요." class="form-control" id="test_no" name="test_no">
                                        <span class="input-group-addon"><button class="btn btn-success btn-xs" id="btn_int" type="button" onclick="javascript:fn_init('test_no');">초기화</button></span>
                                    </div>
                                </div>
                            </div>
                        </fieldset>




                        <fieldset>
                            <form name="srch_form" id="srch_form">
                                <input type="hidden" id="gubun2" name="gubun2" value="" />
                                <input type="hidden" id="gubun" name="gubun" />
                                <input type="hidden" id="srchTitle" name="srchTitle" />

                                <!-- 페이징 처리 필요 변수 -->
                                <input type="hidden" id="list_count" name="list_count" />
                                <input type="hidden" id="current_page" name="current_page" />
                                <input type="hidden" id="page_limit" name="page_limit" />
                                <input type="hidden" id="max_page" name="max_page" />
                                <input type="hidden" id="start_page" name="start_page" />
                                <input type="hidden" id="end_page" name="end_page" />
                                <input type="hidden" id="board_limit" name="board_limit" />

                            </form>
                        </fieldset>


                        <fieldset>
                            <div class="form-group has-success">
                                <div class="col-sm-12">
                                    <button id="btn_search" type="button" class="btn btn-primary btn-sm pull-right" onclick="javascript:fn_search()" style="margin-right:3px;"><span class="btn-label"><i class="ti-search"></i></span> 검 색</button>
                                </div>
                            </div>
                        </fieldset>



                        <!--적치 영역-->
                        <fieldset id="div_area1" style="display:none">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="input-group">
                                        <span class="input-group-addon">적치 장소</span>
                                        <input type="text" placeholder="적치 장소 코드" class="form-control" id="area_cd" name="area_cd" readonly="readonly">
                                        <span class="input-group-addon"><button class="btn btn-success btn-xs" id="btn_int" type="button" onclick="javascript:fn_init('area');">초기화</button></span>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <!--팔레트 영역-->
                        <fieldset id="div_pallet1" style="display:none">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="input-group">
                                        <span class="input-group-addon">적치 팔레트</span>
                                        <input type="text" placeholder="적치 팔레트 코드" class="form-control" id="pallet_cd" name="pallet_cd" readonly="readonly">
                                        <span class="input-group-addon"><button class="btn btn-success btn-xs" id="btn_int" type="button" onclick="javascript:fn_init('pallet');">초기화</button></span>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <fieldset>
                            <div class="form-group has-success">
                                <hr />
                            </div>
                        </fieldset>


                        <fieldset>
                            <div class="table-responsive table-full-width max-h-315 h-50">
                                <table id="srchList" class="table table-hover w-s-nr">
                                    <thead style="background: #4EAE51; color: white;">
                                    <th>품목명</th>
                                    <th>바코드 번호</th>
                                    <th>시험 번호</th>
                                    <th>위치</th>
                                    <th>재고량</th>
                                    </thead>

                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </fieldset>

                        <fieldset style="text-align: center;">
                            <ul class="pagination">
                            </ul>
                        </fieldset>
                    </div>
                </div>  <!-- end card -->
            </div> <!-- end col-md-12 -->
        </div> <!-- end row -->
    </div>

</div>


<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/jquery/jquery-3.2.1.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/bootstrap/js/popper.js"></script>
<script src="~/Content/Table_Fixed_Header/vendor/bootstrap/js/bootstrap.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/select2/select2.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/js/main.js"></script>

<script type="text/javascript">

    $(function () {
        fn_search();

        if (screen.height > 640) {
            $("#srchList").parent().removeClass("max-h-315");
            $("#srchList").parent().addClass("max-h-650");
        }
        

        // 테이블 resize 핸들러
        resize_table();


        var checkWeb = fn_mobile_ckeck();
        if (checkWeb == "web") {
            $("div.table-responsive.table-full-width").css("overflow-x", "auto");
            resize_Web_table("srchList", 650);
        }

    })


    // 웹환경 바코드 스캔 시 동작
    var keyValue = ""; // 바코드 입력 시 값을 저장할 변수 선언
    var insertChk = false; // 스캐너 입력으로 fn_callBarcodeInfo함수가 한 번 호출되었을 경우 = 스캐너 입력으로 검색이 한 번 실행된 경우 초기화
    var insertCount = 1; // 스캐너 입력으로 fn_callBarcodeInfo함수가 한 번 호출되었을 경우 = 스캐너 입력으로 검색이 한 번 실행된 경우 초기화
    $("body").keypress(function (event) {
        if (event.keyCode != 13) {
            keyValue += String.fromCharCode(event.keyCode); // 변수keyValue에 스캔 값 저장
            insertCount = 0; // fn_callBarcodeInfo함수 호출 조건 입력
        }

        // 입력된 값이 엔터이고 엔터가 입력되기 전 알파벳 또는 숫자가 입력된 경우
        if (event.keyCode == 13 && insertCount == 0) {

            insertChk = true; // fn_callBarcodeInfo함수 호출 조건 입력
        }

        // 조건 만족 시 fn_callBarcodeInfo함수 호출
        if (insertChk && insertCount == 0) {
            $("#test_no").val(keyValue); // keyValue변수 초기화를 위해 temp변수로 이동
            keyValue = "";  // 변수keyValue 초기화
            insertChk = false; // fn_callBarcodeInfo함수 호출 조건 초기화
            insertCount = 1; // fn_callBarcodeInfo함수 호출 조건 초기화

            fn_searchByBarcode("ExamSearch", { 'barcode': $("#test_no").val().replaceAll("\0", "") });
        }

    })


    /*
     * 데이터 검색(by 바코드)
     */
    function fn_searchByBarcode(actionName, params) {

        // 폼 초기화W
        $('#srchList > tbody').empty();
        var callUrl = "/PDA_ExamSearch_Item/" + actionName;
        var request = JSON.stringify(params);
        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $("#current_page").val(1);
                $("#list_count").val(data.length);

                if (data.length <= 0) {

                    swal({
                        title: '데이터가 없습니다.',
                        //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                        type: 'error'
                        //timer: 1000
                    }
                    );
                } else {
                    for (var i = 0; i < data.length; i++) {

                        var item_nm = data[i].item_nm;
                        var box_barcode_no = data[i].box_barcode_no;
                        var test_no = data[i].lot_no;
                        var stock_qty = data[i].stock_qty;
                        var location = data[i].location;

                        $("#test_no").val(data[i].test_no);

                        var trHtml = '<tr>';
                        trHtml += ' <td class="cell100" style="width : 30%;text-align: center">' + item_nm + '</td>';
                        trHtml += ' <td class="cell100" style="width : 20%;text-align: center">' + box_barcode_no + '</td>';
                        trHtml += ' <td class="cell100" style="width : 20%;text-align: center">' + test_no + '</td>';
                        trHtml += ' <td class="cell100" style="width : 30%;text-align: center">' + location + '</td>';
                        trHtml += ' <td class="cell100" style="width : 20%;text-align: center">' + stock_qty + '</td>';
                        trHtml += '</tr>';

                        $('#srchList > tbody').append(trHtml);
                    }

                }

                // 테이블 resize
                resize_table();

                // 페이징 처리
                pagination();

            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }
        });
    }



    /*
    * 데이터 검색
    */
    function fn_search() {
        //
        // 폼 초기화
        $('#srchList > tbody').empty();
        var test_no = $("#test_no").val();

        // 초기화
        var params = {
            'item_cd': '', 'item_nm': '', 'test_no': '', 'gubun': '', 'barcode': ''
        };

        var callUrl = "/PDA_ExamSearch_Item/ExamSelect";
        var request = JSON.stringify(params);

        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $("#current_page").val(1);
                $("#list_count").val(data.length);

                if (data.length <= 0) {

                    swal({
                        title: '데이터가 없습니다.',
                        //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                        type: 'error'
                        //timer: 1000
                    }
                    );
                } else {

                    for (var i = 0; i < data.length; i++) {

                        var item_nm = data[i].item_nm;
                        var box_barcode_no = data[i].box_barcode_no
                        var test_no = data[i].lot_no;
                        var stock_qty = data[i].stock_qty;
                        var location = data[i].location;

                        var trHtml = '<tr>';
                        trHtml += ' <td class="cell100" style="width : 30%;text-align: center">' + item_nm + '</td>';
                        trHtml += ' <td class="cell100" style="width : 20%;text-align: center">' + box_barcode_no + '</td>';
                        trHtml += ' <td class="cell100" style="width : 20%;text-align: center">' + test_no + '</td>';
                        trHtml += ' <td class="cell100" style="width : 30%;text-align: center">' + location + '</td>';
                        trHtml += ' <td class="cell100" style="width : 20%;text-align: center">' + stock_qty + '</td>';

                        //trHtml += ' <td class="cell100" style="width : 15%;text-align: center"><button type="button" class="btn btn-primary btn-lg" onclick="javascript:fn_choice(\'' + box_barcode_no + '\')">선 택</button></td>';
                        trHtml += '</tr>';

                        $('#srchList > tbody').append(trHtml);
                    }

                }
                // 테이블 resize
                resize_table();

                // 페이징 처리
                pagination();

            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }
        });        

    }



    /*
   * 필드 초기화
   */
    function fn_init(mode) {

        if (mode == 'area') {       // 적치 장소

            $("#div_area1").hide("fast");
            //$("#div_area2").hide("fast");
            $("#area_cd").val('');

        } else if (mode == 'pallet') {  // 팔레트 장소

            $("#div_pallet1").hide("fast");
            //$("#div_pallet2").hide("fast");
            $("#pallet_cd").val('');

        } else if (mode == 'test_no') {       // 시험번호

            $("#test_no").val('');

        } else if (mode == 'srch_nm1') {

            $("#srch_cd1").val('');
            $("#srch_nm1").val('');

        }
    }



    function resize_table() {
        var count = $("#srchList tbody tr").length;
        var newHeight = 48 + (count * 45);

        $("#srchList").parent().removeClass("h-50");
        $("#srchList").parent().height(newHeight);
    }

</script>
