<script src="~/Content/Table_Fixed_Header/js/main.js"></script>


<script type="text/javascript">

    $(function () {
        fn_search();

        if (screen.height > 640) {
            $("#srchList").parent().removeClass("max-h-315");
            $("#srchList").parent().addClass("max-h-650");
        }

        // 테이블 resize 핸들러
        resize_table();

        var checkWeb = fn_mobile_ckeck();
        if (checkWeb == "web") {
            $("div.table-responsive.table-full-width").css("overflow-x", "auto");
            resize_Web_table("srchList", 650);
        }
    })

    // 웹환경 바코드 스캔 시 동작
    var keyValue = ""; // 바코드 입력 시 값을 저장할 변수 선언
    var insertChk = false; // 스캐너 입력으로 fn_callBarcodeInfo함수가 한 번 호출되었을 경우 = 스캐너 입력으로 검색이 한 번 실행된 경우 초기화
    var insertCount = 1; // 스캐너 입력으로 fn_callBarcodeInfo함수가 한 번 호출되었을 경우 = 스캐너 입력으로 검색이 한 번 실행된 경우 초기화
    $("body").keypress(function (event) {

        // 입력된 값이 알파벳, 숫자일 경우
        if ((event.keyCode >= 65 && event.keyCode <= 90) || (event.keyCode >= 48 && event.keyCode <= 57)) {
            keyValue += String.fromCharCode(event.keyCode); // 변수keyValue에 스캔 값 저장
            insertCount = 0; // fn_callBarcodeInfo함수 호출 조건 입력
        }

        // 입력된 값이 엔터이고 엔터가 입력되기 전 알파벳 또는 숫자가 입력된 경우
        if (event.keyCode == 13 && insertCount == 0 && (keyValue.length <= 13 && keyValue.length >= 5)) {

            insertChk = true; // fn_callBarcodeInfo함수 호출 조건 입력
        }

        // 입력된 바코드 값이 너무 크거나 작으면 초기화
        if (event.keyCode == 13 && (keyValue.length > 13 || keyValue.length < 5)) {
            keyValue = "";
            insertChk = false; // fn_callBarcodeInfo함수 호출 조건 초기화
            insertCount = 1; // fn_callBarcodeInfo함수 호출 조건 초기화
        }

        // 조건 만족 시 fn_callBarcodeInfo함수 호출
        if (insertChk && insertCount == 0) {
            var keyValue_temp = keyValue; // keyValue변수 초기화를 위해 temp변수로 이동
            keyValue = "";  // 변수keyValue 초기화
            insertChk = false; // fn_callBarcodeInfo함수 호출 조건 초기화
            insertCount = 1; // fn_callBarcodeInfo함수 호출 조건 초기화

            fn_callBarcodeInfo({ 'barcode': keyValue_temp.replaceAll("\0", "") });
        }

    })

    /*
 * 바코드관련 상세 정보 호출
 */
    function fn_callBarcodeInfo(params) {
        // 특수문자 제거
        if (typeof params.barcode == "undefined" || params.barcode == null || params.barcode == "" || params.barcode == "null") {

            params.barcode = params.barcode.replaceAll("\0", "");
        }

        // 스캔한 바코드 셋팅
        $("#srch_cd1").val(params.barcode);


        // 테이블 초기화
        $('#srchList > tbody').empty();

        var controllerName = "PackSelect";
        var actionName = "SelectPack";


        var callUrl = "/" + controllerName + "/" + actionName;

        var request = JSON.stringify(params);

        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: "application/json; charset=UTF-8",
            success: function (data) {

                if (data.item_cd == null) {
                    // 스캔한 바코드가 팩, 지함이 아닐 경우 null 대신 들어갈 더미 키워드 입력
                    $("#srch_cd1").val("ZZ999-999");
                } else {
                    $("#srch_cd1").val(data.item_cd);
                }
                fn_search();

            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }
        });

    }


    /*
     * 데이터 검색
     */
    function fn_search() {

        $('#srchList > tbody').empty();
        var srch_cd1 = $("#srch_cd1").val();
        var srch_cd2 = $("#srch_cd2").val();
        var srch_check = '';

        // 사용여부 확인
        if ($('#srch_check').is(":checked")) {
            srch_check = 'Y';
        } else {
            srch_check = 'N';
        }

        var params = {
            's_item': srch_cd1,
            's_lot_no': srch_cd2,
            'use_ck': srch_check
        };

        var callUrl = "/PDA_ItemStockStatus_NUM/ItemStockStatus_Search";
        var request = JSON.stringify(params);

        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $("#current_page").val(1);
                $("#list_count").val(data.length);

                if (data.length <= 0) {

                    swal({
                        title: '데이터가 없습니다.',

                        type: 'error'
                    });

                    $("#list_count").val(0);
                    $("#current_page").val(0);

                } else {

                    for (var i = 0; i < data.length; i++) {

                        var item_cd = data[i].item_cd;
                        var item_nm = data[i].item_nm;
                        var item_lot_size = data[i].item_lot_size;
                        var lot_no = data[i].lot_no;
                        var lot_date = data[i].lot_date;
                        var prod_qty_sum = Math.floor(data[i].prod_qty_sum);
                        var etc_in_qty_sum = Math.floor(data[i].etc_in_qty_sum);
                        var issue_qty_sum = Math.floor(data[i].issue_qty_sum);
                        var etc_out_qty_sum = Math.floor(data[i].etc_out_qty_sum);
                        var prod_qty_plan = Math.floor(data[i].prod_qty_plan);
                        var stock_qty_sum = Math.floor(data[i].stock_qty_sum);

                        //item_stock_id	item_cd	item_nm							etc_out_qty_sum	theory_qty	prod_qty_plan	stock_qty_sum	ISSUE_STATUS	item_move

                        var trHtml = '<tr>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + item_cd + '</td>';
                        trHtml += ' <td class="cell100" style="width : 50%;text-align: center">' + item_nm + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + item_lot_size + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + stock_qty_sum + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + lot_no + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + lot_date + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + prod_qty_sum + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + etc_in_qty_sum + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + issue_qty_sum + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + etc_out_qty_sum + '</td>';
                        trHtml += ' <td class="cell100" style="width : 10%;text-align: center">' + prod_qty_plan + '</td>';
                        
                        trHtml += '</tr>';

                        $('#srchList > tbody').append(trHtml);
                    }

                }
                // 페이징 처리
                pagination();

                // 테이블 resize
                resize_table();

            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }
        });
    }



    // 테이블 resize 핸들러
    function resize_table() {
        var count = $("#srchList tbody tr").length;
        var newHeight = 48 + (count * 45);

        $("#srchList").parent().removeClass("h-50");
        $("#srchList").parent().height(newHeight);
    }

</script>