<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <div class="card-header">
                        <h4 class="card-title" id="div_title">
                            구역 정보 조회
                        </h4>
                    </div>

                    <div class="card-content">
                        <fieldset>
                            <div class="form-group has-success">

                                <input type="hidden" name="controllerName" id="controllerName" value="ZoneSelect" />
                                <input type="hidden" name="actionName" id="actionName" value="SelectZone" />

                                <!-- 창고 바코드-->
                                <input type="hidden" name="init_barcode" id="init_barcode" value="@ViewData["barcode"]" />

                                <div class="form-horizontal" name="myForm" id="myForm">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">창고</label>
                                        <div class="col-sm-9">
                                            <input type="hidden" id="barcode_val" name="barcode_val" class="input-css" readonly="readonly" />
                                            <input type="hidden" id="workroom_cd" name="workroom_cd" class="input-css" readonly="readonly" />
                                            <input type="text" id="workroom" name="workroom" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">구역</label>
                                        <div class="col-sm-9">
                                            <input type="hidden" id="zone_cd" name="zone_nm" class="input-css" readonly="readonly" />
                                            <input type="text" id="zone" name="zone" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">구역타입</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="zone_type_nm" name="zone_type_nm" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">우선순위</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="zone_priority" name="zone_priority" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">구역상태</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="zone_status_nm" name="zone_status_nm" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">총 셀</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="cell_cnt" name="cell_cnt" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">사용 셀 수</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="use_cell" name="use_cell" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">빈 셀 수</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="empty_cell" name="empty_cell" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">비고</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="zone_remark" name="zone_remark" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">허용 온도</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="permit_temp" name="permit_temp" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label" style="margin-bottom: auto; font-size : 18px">허용 습도</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="permit_hum" name="permit_hum" class="input-css" readonly="readonly" />
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </fieldset>
                        

                        <fieldset>
                            <div class="form-group has-success">
                                <hr />
                            </div>
                        </fieldset>

                        <fieldset>
                            <div class="form-group has-success">

