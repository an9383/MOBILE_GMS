<script type="text/javascript">

    $(document).ready(function () {

        if ($('#init_barcode').val() != '') {
            var params = { 'barcode': $('#init_barcode').val() };

            fn_callBarcodeInfo(params);
        }

    });

    /*
     * 바코드관련 상세 정보 호출
     */
    function fn_callBarcodeInfo(params) {

        // 스캔한 바코드 셋팅
        $("#barcode_val").val(params.barcode);

        // 스캔한 바코드 분기처리
        var barcode_gubun = fn_getBarcodePrefix(params.barcode);

        // 팩/지함별 적치
        if (barcode_gubun === 'P') {
            controllerName = 'PackStack';
            actionName = 'Index';

            params.area_barcode = $('#init_barcode').val();

            fn_locationByGet(controllerName, actionName, params);
            return;
        }

        var controllerName = $("#controllerName").val();
        var actionName = $("#actionName").val();
        //var barcode = params.barcode;

        var callUrl = "/" + controllerName + "/" + actionName;

        var request = JSON.stringify(params);

        
        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                if (typeof data.zone_cd == "undefined" || data.zone_cd == null || data.zone_cd == "" || data.zone_cd == "null") {

                    swal({
                        title: '바코드 정보가 없습니다.',
                        //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                        type: 'error'
                        //timer: 1000
                    });

                    return;

                } else {
                    $("#zone_cd").val(data.zone_cd);
                    $("#zone_nm").val(data.zone_nm);
                    $('#zone').val(data.zone_nm + ' / ' + data.zone_cd); //결과값 조합
                    $("#zone_type").val(data.zone_type);
                    $("#zone_type_nm").val(data.zone_type_nm);
                    $("#zone_priority").val(data.zone_priority);
                    $("#zone_status").val(data.zone_status);
                    $('#permit_temp').val(data.permit_temp);
                    $('#permit_hum').val(data.permit_hum);
                    $('#workroom_cd').val(data.workroom_cd);
                    $('#workroom_nm').val(data.workroom_nm);
                    $('#workroom').val(data.workroom_nm + ' / ' + data.workroom_cd); //결과값 조합
                    $('#cell_cnt').val(data.cell_cnt);
                    $('#use_cell').val(data.use_cell);
                    $('#empty_cell').val(data.empty_cell);
                    $('#zone_remark').val(data.zone_remark);
                    $('#init_barcode').val(data.barcode);

                    // 버튼 활성화 처리
                    fn_setEnabledObj('btn_stack', 'btn-default', 'btn-primary', false);
                    fn_setEnabledObj('btn_pick', 'btn-default', 'btn-primary', false);
                }

            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }
        });

    }

    /*
     *  팩/지함별 적치
     */
    function fn_stackPack() {

        var controllerName = "PackStack";
        var actionName = "Index";
        var barcode = $('#init_barcode').val();
        var area_barcode = "";
        if ($('#barcode_val').val() != '' && fn_getBarcodePrefix($('#barcode_val').val()) != 'P') {
            area_barcode = $('#barcode_val').val().replaceAll("\0", "");
        }

        // APP에서 barcode 넘길때 이상문자 붙음(\0).
        // 그래서 replaceall로 모두 없앰.
        var jsonParam = {
            'barcode': barcode.replaceAll("\0", ""),
            'module_cd': '@ViewData["module_cd"]',
            'area_barcode': area_barcode
        };

        // 페이지 이동(적치 화면 이동)
        fn_locationByGet(controllerName, actionName, jsonParam);

    }

    /*
     *  피킹 처리
     */
    function fn_pickPack() {

        var controllerName = "Picking";
        var actionName = "Index";
        var barcode = $('#init_barcode').val();

        var jsonParam = {
            'barcode': barcode.replaceAll("\0", ""),
            module_cd: '@ViewData["module_cd"]'
        };

        fn_locationByGet(controllerName, actionName, jsonParam);

    }


</script>