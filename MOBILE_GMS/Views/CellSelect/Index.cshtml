                        </div>

                        <div class="card-content">
                            <!--
                            <fieldset>
                                <legend style="font-size: 18px">셀 정보 조회</legend>
                            </fieldset>
                            -->
                            <input type="hidden" name="barcode_val" id="barcode_val" />
                            <input type="hidden" name="srch_cd1" id="srch_cd1" />
                            <input type="hidden" name="srch_nm1" id="srch_nm1" />

                            <input type="hidden" name="controllerName" id="controllerName" value="CellSelect" />
                            <input type="hidden" name="actionName" id="actionName" value="SelectCell" />
                            <!-- 셀 바코드 -->
                            <input type="hidden" name="init_barcode" id="init_barcode" value="@ViewData["barcode"]" />
                            <input type="hidden" name="c_barcode" id="c_barcode" />

