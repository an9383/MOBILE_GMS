<script src="~/Content/Table_Fixed_Header/js/main.js"></script>


<script type="text/javascript">
    $(document).ready(function () {

        // 모바일 기기 체크
        fn_moblieCK();

        if ($('#init_barcode').val() != '') {
            var params = { 'barcode': $('#init_barcode').val() };

            fn_callBarcodeInfo(params);
        }

        if (screen.height > 640) {
            $("#cellList").parent().removeClass("max-h-315");
            $("#cellList").parent().addClass("max-h-650");
        }

        // 테이블 resize 핸들러
        resize_table();

        var checkWeb = fn_mobile_ckeck();
        if (checkWeb == "web") {
            $("div.table-responsive.table-full-width").css("overflow-x", "auto");
            resize_Web_table("cellList", 650);
        }

    });

    // 바코드 초기화 (웹 환경에서 사용됨)
    function setBarcodeInit() {
        $('#cell_cd').val('');

    }

    // 엔터키 동작 (웹 환경에서 사용됨)
    function onKeyDown() {

        // 엔터키 코드
        if (event.keyCode == 13) {

            var barcode = $("#cell_cd").val();
            // 포커스 해제
            $("#cell_cd").blur();

            fn_callBarcodeInfo({ 'barcode': barcode.replaceAll("\0", "") });

        }

    }

    /*
     * 바코드관련 상세 정보 호출
     */
    function fn_callBarcodeInfo(params) {

        // 특수문자 제거
        if (typeof params.barcode == "undefined" || params.barcode == null || params.barcode == "" || params.barcode == "null") {

            params.barcode = params.barcode.replaceAll("\0", "");
        }

        // 컨트롤 / 액션
        var controllerName = $("#controllerName").val();
        var actionName = $("#actionName").val();

        // 스캔한 바코드 셋팅
        var barcode_gubun = fn_getBarcodePrefix(params.barcode);

        if (barcode_gubun === 'P') {
            // 셀 바코드가 미입력(스캔) 상태
            if ($('#init_barcode').val() === '') {
                controllerName = 'PackSelect';
                actionName = 'Index';

                fn_locationByGet(controllerName, actionName, params);
                return;
            } else {
                $("#cell_cd").val(params.barcode);

                fn_cellPack();

                return;
            }
        } else if (barcode_gubun === 'G') {
            // 셀 바코드가 미입력(스캔) 상태
            if ($('#init_barcode').val() === '') {
                controllerName = 'PackSelect';
                actionName = 'Index';

                fn_locationByGet(controllerName, actionName, params);
                return;
            } else {
                $("#cell_cd").val(params.barcode);

                fn_cellPack();

                return;
            }
        } else if (barcode_gubun === 'Z') {
            controllerName = 'ZoneSelect';
            actionName = 'Index';

            fn_locationByGet(controllerName, actionName, params);
            return;
        } else if (barcode_gubun === 'W') {
            controllerName = 'WorkRoomSelect';
            actionName = 'Index';

            fn_locationByGet(controllerName, actionName, params);
            return;
        }

        var callUrl = "/" + controllerName + "/" + actionName;

        var request = JSON.stringify(params);

        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                if (typeof data.cell_cd == "undefined" || data.cell_cd == null || data.cell_cd == "" || data.cell_cd == "null") {

                    swal({
                        title: '바코드 정보가 없습니다.',
                        //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                        type: 'error'
                        //timer: 1000
                    });

                    return;

                } else {
                    $("#cell_cd").val(data.cell_cd);
                    $("#cell_nm").val(data.cell_nm);
                    $("#cell_type_nm").val(data.cell_type_nm);
                    $("#cell_status").val(data.cell_status);
                    $("#location").val(data.location);
                    $("#cell_priority").val(data.cell_priority);
                    $("#cell_isle").val(data.cell_isle);
                    $("#cell_remark").val(data.cell_remark);
                    $('#init_barcode').val(data.barcode);
                }

                fn_callGridSelectCell(params, controllerName, "GridSelectCell");

                // 버튼 활성화 처리
                fn_setEnabledObj('btn_stack', 'btn-default', 'btn-primary', false);
                fn_setEnabledObj('btn_pick', 'btn-default', 'btn-primary', false);

                $("#c_barcode").val(params.barcode);


            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }




        });
    }

    /*
     * 팩 정보(바코드)에 포함된 팩 사용 히스토리
     */
    function fn_callGridSelectCell(params, controllerName, actionName) {

        var callUrl = "/" + controllerName + "/" + actionName;

        var request = JSON.stringify(params);
        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $('#cellList > tbody').empty();
                $("#list_count").val(data.length);
                $("#current_page").val(1);

                for (var i = 0; i < data.length; i++) {

                    var pack_barcode = data[i].pack_barcode;
                    var item_nm = data[i].item_nm;
                    var lot_no = data[i].lot_no;
                    var receipt_pack_remain_qty = data[i].receipt_pack_remain_qty;

                    $('#cellList > tbody').append('<tr class="row100 body" ><td class="cell100 column1">' + pack_barcode
                        + '</td><td class="cell100 column2">' + item_nm
                        + '</td><td class="cell100 column3">' + lot_no
                        + '</td><td class="cell100 column4">' + receipt_pack_remain_qty + '</td></tr>');
                }
                // 테이블 resize
                resize_table();

                // 페이징 처리
                pagination();

            },
            error: function (data) {
                alert('error' + data.status);
            }
        });
    }

    /*
     *  위치 별 적치 화면으로 이동
     */
    function fn_cellPack() {

        // 웹 환경에선 적치/피킹 기능 제외 (테블릿 조회 목적)
        /*if (document.getElementById('pc_object') && document.getElementById('pc_object').style.display === 'block') {
            swal({
                title: '웹 환경에선 적치/피킹 기능이 제한 됩니다.',
                type: 'info'
            });
            return;
        }*/

        var controllerName = "CellStack";
        var actionName = "Index";
        var cell_cd = $("#cell_cd").val();
        var jsonParam = {
                cell_cd: cell_cd,
                module_cd: '@ViewData["module_cd"]',
                barcode: $("#cell_cd").val().replaceAll("\0", ""),
                c_barcode: $("#c_barcode").val()
            };



        fn_locationByGet(controllerName, actionName, jsonParam);

    }

    /*
     *  피킹 화면으로 이동
     */
    function fn_cellPicking() {

        // 웹 환경에선 적치/피킹 기능 제외 (테블릿 조회 목적)
/*
        if (document.getElementById('pc_object') && document.getElementById('pc_object').style.display === 'block') {
            swal({
                title: '웹 환경에선 적치/피킹 기능이 제한 됩니다.',
                type: 'info'
            });
            return;
        }
*/
        var controllerName = "Picking";
        var actionName = "Index";
        var barcode = $('#init_barcode').val();

        var jsonParam = {
            'barcode': barcode.replaceAll("\0", ""),
            module_cd: '@ViewData["module_cd"]'
        };

        fn_locationByGet(controllerName, actionName, jsonParam);

    }

    /*
     * 데이터 검색
     */
    function fn_search() {

        var srch_cd = $("#srch_cd1").val();
        var srch_nm = $("#srch_nm1").val();
        // 코드( 셀 바코드) 설정
        $("#cell_cd").val(srch_cd);

        fn_callBarcodeInfo({ 'barcode': srch_cd });

        $('#btn_itemFind').blur();  // 검색 버튼 포커스 없애기..

    }

    function resize_table() {
        var count = $("#cellList tbody tr").length;
        var newHeight = 48 + (count * 45);

        $("#cellList").parent().removeClass("h-50");
        $("#cellList").parent().height(newHeight);
    }


</script>