                            <input type="hidden" id="list_count" name="list_count" />
                            <input type="hidden" id="current_page" name="current_page" />
                            <input type="hidden" id="page_limit" name="page_limit" />
                            <input type="hidden" id="max_page" name="max_page" />
                            <input type="hidden" id="start_page" name="start_page" />
                            <input type="hidden" id="end_page" name="end_page" />
                            <input type="hidden" id="board_limit" name="board_limit" />

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">코드</label>
                                    <div class="col-sm-10">
                                        <div class="input-group">

                                            <span id="mobile_object" style="display:none">

                                                <input type="text" class="input-css" id="cell_cd" name="mobile_object" readonly="readonly" />

                                            </span>
                                            <span id="pc_object" style="display:none">

                                                <input type="text" class="input-css" id="cell_cd" name="pc_object" onkeydown="onKeyDown();" onfocus="setBarcodeInit()" />

                                            </span>

                                            <span class="input-group-btn">
                                                <button class="btn btn-warning btn-lg btn-fill" id="btn_itemFind" type="button" style="height:40px;" onclick="javascript:fn_findItem('CellSelect_win','cell','셀 정보 조회')"><span class="btn-label"><i class="ti-search"></i></span></button>
                                            </span>

                                        </div>
                                    </div>
                                </div>

                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">셀 명</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="cell_nm" name="cell_nm" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">셀 타입</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="cell_type_nm" name="cell_type_nm" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">셀 상태</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="cell_status" name="cell_status" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">위 치</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="location" name="location" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">우선 순위</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="cell_priority" name="cell_priority" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>


                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">위치 통로</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="cell_isle" name="cell_isle" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>



                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">비 고</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="cell_remark" name="cell_remark" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <div class="col-sm-12">
                                        <hr />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="table-responsive table-full-width max-h-315 h-50">
                                    <table id="cellList" class="table table-hover w-s-nr">
                                        <thead style="background: #4EAE51; color: white;">
                                        <th>바코드</th>
                                        <th>품목명</th>
                                        <th>제조(시험번호)</th>
                                        <th>재고량</th>
                                        </thead>

                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>

                            <fieldset style="text-align: center">
                                <ul class="pagination">
                                </ul>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">

                                    <div class="col-sm-12">
                                        <hr />
                                        <button id="btn_stack" type="button" class="btn btn-default btn-lg" disabled="disabled" onclick="fn_cellPack()">적 치</button>
                                        <button id="btn_pick" type="button" class="btn btn-default btn-lg pull-right" disabled="disabled" onclick="fn_cellPicking()">피 킹</button>
                                    </div>
                                </div>
                            </fieldset>


                        </div>
                    </form>
                </div>  <!-- end card -->
            </div> <!-- end col-md-12 -->
        </div> <!-- end row -->
    </div>

</div>

