<script type="text/javascript">
    $(function () {

        resize_table();

        if (screen.width > 360) {
            $("#tb_wherevalue").css("font-size", "22px");
        }

    })


    /*
     * 바코드관련 상세 정보 호출
     */
    function fn_callBarcodeInfo(params) {

    }


    /*
     * 데이터 검색
     */
    function fn_search() {

        var tb_wherevalue = $.trim($("#tb_wherevalue").val());
        // validation
        if (typeof tb_wherevalue == "undefined" || tb_wherevalue == null || tb_wherevalue == "") {

            swal({
                title: '검색어를 입력해주세요.',
                type: 'error',
                allowOutsideClick: false,
                closeOnClickOutside: false
            }
            ).then(
                function () {
                    setTimeout(function () {
                        $("#tb_wherevalue").focus();
                    }, 600);
                }
            );

            return;
        }

        // 초기화
        var params = { 'tb_wherevalue': tb_wherevalue, 'gubun':'@Model.gubun' };
        $('#srchList > tbody').empty();
        var callUrl = "/CodeHelp/CodeHelpSearch";
        var request = JSON.stringify(params);
        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                for (var i = 0; i < data.length; i++) {

                    var srch_cd1 = data[i].srch_cd1;
                    var srch_nm1 = data[i].srch_nm1;
                    var srch_cd2 = data[i].srch_cd2;
                    var srch_nm2 = data[i].srch_nm2;

                    var trHtml = '<tr onclick="fn_choice(\'' + srch_cd1 + '\',\'' + srch_nm1 + '\',\'' + srch_cd2 + '\',\'' + srch_nm2 + '\')">';
                    trHtml += '<td class="cell100" style="width : 40%; text-align: center">' + srch_cd1 + '</td>';
                    trHtml += '<td><a style="color : #19741C; font-weight: 800;">' + srch_nm1 + '</td>';
                    trHtml += '</tr>';

                    $('#srchList > tbody').append(trHtml);
                }

                resize_table();
            },
            error: function (data) {
                alert('error' + data.status);
            }
        });
    }

    /*
     * 검색 데이터 선택 및 부모창으로 데이터 전송
     */
    function fn_choice(srch_cd1, srch_nm1, srch_cd2, srch_nm2) {


        try {
            opener.document.getElementById("srch_cd1").value = srch_cd1;
            opener.document.getElementById("srch_nm1").value = srch_nm1;
            opener.document.getElementById("srch_cd2").value = srch_cd2;
            opener.document.getElementById("srch_nm2").value = srch_nm2;
        }
        catch (e) {

        }


        opener.fn_search();

        //window.close();
        window.open('', '_self').close(); 
    }

    function resize_table() {
        var count = $("#srchList tbody tr").length;
        var newHeight = 48 + (count * 45);

        $("#srchList").parent().removeClass("h-50");
        $("#srchList").parent().height(newHeight);
    }


</script>