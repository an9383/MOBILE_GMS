<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <div class="card-header">
                        <h4 class="card-title">
                            위치 별 적치
                        </h4>
                    </div>

                    <div class="card-content">

                        <input type="hidden" name="barcode_val" id="barcode_val" />
                        <input type="hidden" name="controllerName" id="controllerName" value="CellStack" />
                        <input type="hidden" name="actionName" id="actionName" value="fncCellDataSearch" />

                        <!-- 페이징 처리 필요 변수 -->
                        <input type="hidden" id="list_count" name="list_count" />
                        <input type="hidden" id="current_page" name="current_page" />
                        <input type="hidden" id="page_limit" name="page_limit" />
                        <input type="hidden" id="max_page" name="max_page" />
                        <input type="hidden" id="start_page" name="start_page" />
                        <input type="hidden" id="end_page" name="end_page" />
                        <input type="hidden" id="board_limit" name="board_limit" />

                        <!-- 셀 바코드 -->
                        <input type="hidden" name="init_barcode" id="init_barcode" value="@ViewData["barcode"]" />
                        <input type="hidden" name="c_barcode" id="c_barcode" value="@ViewData["c_barcode"]" />

                        <div class="form-group has-success">

                            <fieldset>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px" id="locArea">셀</label>

                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">코드</span>

                                            <span id="mobile_object" style="display:none">

                                                <input type="text" class="form-control" id="cell_cd" name="mobile_object" readonly="readonly" />

                                            </span>
                                            <span id="pc_object" style="display:none">

                                                <input type="text" class="form-control" id="cell_cd" name="pc_object" onkeydown="onKeyDown();" onfocus="setBarcodeInit()" />

                                            </span>
                                        </div>
                                    </div>


                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">명칭</span>
                                            <input type="text" placeholder="" class="form-control" id="cell_nm" name="cell_nm" readonly="readonly">
                                        </div>
                                    </div>

                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px" id="locArea">창고</label>

                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">코드</span>
                                            <input type="text" placeholder="" class="form-control" id="workroom_cd" name="workroom_cd" readonly="readonly">
                                        </div>
                                    </div>
                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">명칭</span>
                                            <input type="text" placeholder="" class="form-control" id="workroom_nm" name="workroom_nm" readonly="readonly">
                                        </div>
                                    </div>

                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px" id="locArea">구역</label>

                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">코드</span>
                                            <input type="text" placeholder="" class="form-control" id="zone_cd" name="zone_cd" readonly="readonly">
                                        </div>
                                    </div>
                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">명칭</span>
                                            <input type="text" placeholder="" class="form-control" id="zone_nm" name="zone_nm" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px" id="locArea">팔레트</label>
                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">코드</span>
                                            <input type="text" placeholder="" class="form-control" id="pallet_cd" name="pallet_cd" readonly="readonly">
                                        </div>
                                    </div>
                                    <div class="col-sm-5">
                                        <div class="input-group">
                                            <span class="input-group-addon">명칭</span>
                                            <input type="text" placeholder="" class="form-control" id="pallet_nm" name="pallet_nm" readonly="readonly">
                                        </div>
                                    </div>

                                </div>
                            </fieldset>
                        </div>

                        <fieldset>
                            <div class="form-group has-success">
                                <hr />
                            </div>
                        </fieldset>

                        <fieldset>
                            <div class="table-responsive table-full-width max-h-315 h-50">
                                <table id="dataList" class="table table-hover w-s-nr">
                                    <thead style="background: #4EAE51; color: white;">
                                    <th style="width: 5%;"><input type="checkbox" style="width: 20px; height: 20px;" id="allCheck" /></th>
                                    <th>바코드</th>
                                    <th>품목명</th>
                                    <th>시험번호</th>
                                    <th>재고량</th>
                                    <th>단위</th>
                                    </thead>

                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </fieldset>

                        <fieldset style="text-align: center">
                            <ul class="pagination">
                            </ul>
                        </fieldset>

                        <fieldset>
                            <div class="form-group has-success">
                                <hr />
                                <button id="btn_stack" type="button" class="btn btn-default btn-lg pull-right" disabled="disabled" onclick="fn_savePackStack()">적 치</button>
                            </div>
                        </fieldset>
                    </div>
                </div>  <!-- end card -->
            </div> <!-- end col-md-12 -->
        </div> <!-- end row -->
    </div>

</div>

