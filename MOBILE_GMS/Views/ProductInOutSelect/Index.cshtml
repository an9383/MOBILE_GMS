    #pagination a {
        display: inline-block;
        margin-right: 5px;
        cursor: pointer;
    }

    th, td {
        text-align: center;
    }
</style>


<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <div class="form-horizontal">
                        <div class="card-header">
                            <h4 class="card-title">
                                완제품 수불현황 조회
                            </h4>
                        </div>

                        <div class="card-content">

                            <input type="hidden" name="barcode_val" id="barcode_val" />

                            <input type="hidden" name="controllerName" id="controllerName" value="ProductInOutSelect" />
                            <input type="hidden" name="actionName" id="actionName" value="ProductInfo" />

                            <input type="hidden" name="box_barcode_no" id="box_barcode_no" />

                            <!-- 페이징 처리 필요 변수 -->
                            <input type="hidden" id="list_count" name="list_count" />
                            <input type="hidden" id="current_page" name="current_page" />
                            <input type="hidden" id="page_limit" name="page_limit" />
                            <input type="hidden" id="max_page" name="max_page" />
                            <input type="hidden" id="start_page" name="start_page" />
                            <input type="hidden" id="end_page" name="end_page" />
                            <input type="hidden" id="board_limit" name="board_limit" />


                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">코드</label>
                                    <div class="col-sm-10">
                                        <span id="mobile_object" style="display:none">

                                            <input type="text" class="form-control" id="item_cd" name="mobile_object" readonly="readonly" />

                                        </span>
                                        <span id="pc_object" style="display:none">

                                            <input type="text" class="form-control" id="item_cd" name="pc_object" onkeydown="onKeyDown();" onfocus="setBarcodeInit()" />

                                        </span>
                                        @*임시 버튼
                                            <input type="text" class="input-css" id="item_cd" onclick="fn_call_Info()" />*@
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">품목명</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="item_nm" class="input-css" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">제조번호</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="lot_no" class="input-css" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">단위</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="keeping_unit" class="input-css" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">입고량</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="receipt_qty" class="input-css" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">재고량</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="stock_qty" class="input-css" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <div class="col-sm-12">
                                        <hr />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="table-responsive table-full-width max-h-315 h-50">
                                    <table id="productList" class="table table-hover w-s-nr">
                                        <thead style="background: #4EAE51; color: white;">
                                        <th class="cell100 column1">일자</th>
                                        <th class="cell100 column2">구분</th>
                                        <th class="cell100 column3">수량</th>
                                        </thead>

                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>

                            <fieldset style="text-align: center;">
                                <ul class="pagination">
                                </ul>
                            </fieldset>
                        </div>
