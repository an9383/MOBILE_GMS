<script type="text/javascript">

    jQuery('document').ready(function () {

        // 모바일 기기 체크
        fn_moblieCK();

        if (screen.height > 640) {
            $("#productList").parent().removeClass("max-h-315");
            $("#productList").parent().addClass("max-h-650");
        }

        // 테이블 resize 핸들러
        resize_table();

        var checkWeb = fn_mobile_ckeck();
        if (checkWeb == "web") {
            $("div.table-responsive.table-full-width").css("overflow-x", "auto");
            resize_Web_table("productList", 650);
        }

    });

    // 바코드 초기화 (웹 환경에서 사용됨)
    function setBarcodeInit() {

        $('#item_cd').val('');

    }

    // 엔터키 동작 (웹 환경에서 사용됨)
    function onKeyDown() {

        // 엔터키 코드
        if (event.keyCode == 13) {

            var barcode = $("#item_cd").val();

            // 포커스 해제
            $("#item_cd").blur();

            fn_callBarcodeInfo({ 'barcode': barcode.replaceAll("\0", "") });

        }

    }


    function fn_callBarcodeInfo(params) {

        // 컨트롤 / 액션
        var controllerName = $("#controllerName").val();
        var actionName = $("#actionName").val();

        var callUrl = "/" + controllerName + "/" + actionName;
        var request = JSON.stringify(params);

        // 화면 초기화
        $("#item_cd").val("");
        $("#item_nm").val("");
        $("#lot_no").val("");
        $("#keeping_unit").val("");
        $("#receipt_qty").val("");
        $("#stock_qty").val("");
        $('#productList > tbody').empty();

        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $("#list_count").val(data.length);
                $("#current_page").val(1);

                if (typeof data.box_barcode_no == "undefined" || data.box_barcode_no == null || data.box_barcode_no == "" || data.box_barcode_no == "null") {

                    swal({
                        title: '바코드 정보가 없습니다.',
                        //text: '적치할 위치의 바코드정보를 스캔해주세요.',
                        type: 'error'
                        //timer: 1000
                    });

                    return;

                } else {

                    $("#item_cd").val(data.item_cd);
                    $("#item_nm").val(data.item_nm);
                    $("#lot_no").val(data.lot_no);
                    $("#keeping_unit").val(data.keeping_unit);
                    $("#receipt_qty").val(data.receipt_qty);
                    $("#stock_qty").val(data.stock_qty);
                    $("#box_barcode_no").val(data.box_barcode_no);
                    $("#barcode").val(data.box_barcode_no);
                }

                console.log(data.box_barcode_no);

                params = {
                    'box_barcode_no': data.box_barcode_no,
                    'page': $("#current_page").val()
                }

                fn_GridSelect(params, "ProductInOutSelect", "GridSelect");

            }, beforeSend: function () {
                fn_loading('show');
            }, complete: function () {
                fn_loading('hide');
            }, error: function (data) {
                alert('error' + data.status);
            }
        });
    }

    /*
     * 완제품 수불현황 히스토리
     */
    function fn_GridSelect(params, controllerName, actionName) {

        var callUrl = "/" + controllerName + "/" + actionName;

        var request = JSON.stringify(params);

        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $('#productList > tbody').empty();
                $("#list_count").val(data.length);
                $("#current_page").val(1);

                console.log(data.length);

                for (var i = 0; i < data.length; i++) {

                    var issue_date = data[i].issue_date;
                    var inout_type = data[i].inout_type;
                    var issue_qty = data[i].issue_qty;

                    $('#productList > tbody').append('<tr class="row100 body" style="text-align: center;" ><td class="cell100 column1">' + issue_date
                        + '</td><td class="cell100 column2">' + inout_type
                        + '</td><td class="cell100 column3">' + issue_qty + '</td></tr>');
                }
                // 테이블 resize
                resize_table();

                // 페이징 처리
                pagination();

                console.log(data);
            },
            error: function (data) {
                alert('error' + data.status);
            }
        });
    }


    function resize_table() {
        var count = $("#productList tbody tr").length;
        var newHeight = 48 + (count * 45);

        $("#productList").parent().removeClass("h-50");
        $("#productList").parent().height(newHeight);
    }

</script>