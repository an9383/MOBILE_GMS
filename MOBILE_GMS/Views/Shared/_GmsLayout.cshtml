     */
                function fn_menu(moduleCd) {
                        window.location.href = '@Url.Action("DashBoard", "Main")?module_cd=' + moduleCd;
                    }

                    /*
                     * 메뉴 변경(하위)
                     */
                    function fn_subMenu(sourceCd, moduleCd) {
                        var controllerName = sourceCd;
                        var actionName = "Index";
                        var subMainUrl = "/" + controllerName + "/" + actionName + "?module_cd=" + moduleCd;
                        window.location.href = subMainUrl;
                    }

                    /*
                     * 화면 이동( 공통 , GET 방식)
                     * parameter => {'key':'value'.... 형태로 넘길것.}
                     */
                    function fn_locationByGet(controllerName, actionName, parameter) {

                        var controllerName = controllerName;
                        var actionName = actionName;
                        var param = '';

                        if (typeof actionName == "undefined" || actionName == null || actionName == "") {
                            //controllerName = controllerName;
                            actionName = "Index";
                        }

                        var recursiveEncoded = $.param(parameter);
                        if (Object.keys(parameter).length > 0) {
                            param = "?" + recursiveEncoded
                        }

                        var goUrl = "/" + controllerName + "/" + actionName + param;
                        window.location.href = goUrl;
                    }

                    /*
                     * 화면 이동( 공통 , POST 방식)
                     * parameter => {'key':'value'.... 형태로 넘길것.}
                     */
                    function fn_locationByPost(controllerName, actionName, parameter) {

                        var controllerName = controllerName;
                        var actionName = actionName;
                        var hiddenField = '';

                        if (typeof actionName == "undefined" || actionName == null || actionName == "") {
                            //controllerName = controllerName;
                            actionName = "Index";
                        }

                        var goUrl = "/" + controllerName + "/" + actionName


        var form = document.createElement("form");
                        form.setAttribute("charset", "UTF-8");
                        form.setAttribute("method", "Post");  //Post 방식
                        form.setAttribute("action", goUrl); //요청 보낼 주소

                        var hiddenField = ''; // document.createElement("input");
                        if (Object.keys(parameter).length > 0) {
                            Object.keys(parameter).forEach(function (k) {
                                hiddenField = document.createElement("input");
                                hiddenField.setAttribute("type", "hidden");
                                hiddenField.setAttribute("name", k);
                                hiddenField.setAttribute("value", parameter[k]);
                                form.appendChild(hiddenField);

                            });
                        }

                        document.body.appendChild(form);

                        form.submit();

                    }



