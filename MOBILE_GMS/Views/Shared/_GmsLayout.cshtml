                    /*
                     * 바코드로 팩/지함인지, 장소인지 구분
                     */
                    function fn_getBarcodeFlag(barcode) {

                        var preFix = barcode.replaceAll("\0", "").substr(0, 1);

                        if ((preFix == 'P') || (preFix == 'G')) {        // 팩/지함 바코드(P:팩 ,G:지함[BOX])
                            return 'PACK';
                        } else if ((preFix == 'W') || (preFix == 'Z') || (preFix == 'C')) { // 장소 정보 코드(W:창고 ,Z:구역,C:셀)
                            return 'LOCATION';
                        }
                    }



                    /*
                     * 바코드 앞 1 자리 리턴
                     */
                    function fn_getBarcodePrefix(barcode) {

                        var preFix = barcode.replaceAll("\0", "").substr(0, 1);

