    /**
     *  모바일 기기 확인
     */
    function fn_moblieCK() {
        // 모바일 기기 여부 변수에 담기

        var m_userAgent_All = navigator.userAgent.toLowerCase();

        var m_userAgent = '';

        var m_mobile = new Array('iphone', 'ipod', 'ipad', 'android', 'blackberry', 'windows ce', 'nokia', 'webos', 'opera mini', 'sonyericsson', 'opera mobi', 'iemobile', 'mot');

        var m_mobileCheck = 0;



        for (var m_count = 0; m_count < m_mobile.length; m_count++) {

            if (m_userAgent_All.indexOf(m_mobile[m_count]) != -1) {

                m_mobileCheck++;

                m_userAgent = m_mobile[m_count];

            }

        }

        var m_platform = navigator.platform.toLowerCase();
        var m_platform_filter = new Array('win16', 'win32', 'win64', 'mac', 'macintel');


        for (var m_count = 0; m_count < m_platform_filter.length; m_count++) {

            if (m_platform.indexOf(m_platform_filter[m_count]) != -1) {

                m_mobileCheck = 0;

            }

        }

        // 모바일 체크 변수 사용

        if (m_mobileCheck > 0) {

            // 모바일기기 입니다.
            $("#mobile_object").css("display", "block");
            $("#pc_object").css("display", "none");

            // 아이디 충돌 방지를 위해 웹 용 아이디 값 변경
            if (document.getElementsByName('pc_object') && document.getElementsByName('pc_object')[0]) {
                document.getElementsByName('pc_object')[0].setAttribute("id", "pc_object_disable");
            }

            return;

        } else {

            // 모바일기기가 아닙니다.
            $("#mobile_object").css("display", "none");
            $("#pc_object").css("display", "block");

            // 아이디 충돌 방지를 위해 모바일 용 아이디 값 변경
            if (document.getElementsByName('pc_object') && document.getElementsByName('mobile_object')[0]) {
                document.getElementsByName('mobile_object')[0].setAttribute("id", "mobile_object_disable");
            }


            return;

        }
    }

    /**
     * 모바일&웹 접속여부 return 값
     */
    function fn_mobile_ckeck() {
        var isMobile = false;
        var WebName = "Win16|Win32|Win64|Mac|Macintel";

        isMobile = WebName.indexOf(navigator.platform) > 0 ? false : true;

        if (isMobile) {
            // 모바일 기기 (PDA)
            return 'moblie';
        } else {
            // 웹 브라우저 (테블릿)

            return 'web';
        }
    }

    // 페이징 처리 함수
    function pagination() {
        /* 페이징 관련 변수 선언 부분 */
        var list_count; // 모든 목록의 수

        var current_page; // 현재 페이지

        var page_limit; // 한 페이지 하단에 보여질 페이지 수
        var max_page;  // 전체 페이지의 가장 마지막 페이지
        var start_page;  // 한 페이지 하단에 보여질 시작 페이지
        var end_page;  // 한 페이지 하단에 보여질 끝 페이지

        var board_limit;  // 한 페이지에 보여질 게시글의 최대 수

        current_page = $("#current_page").val() != 1 ? $("#current_page").val() : 1;

        var checkWeb = fn_mobile_ckeck();
        if (checkWeb == "web") {
            page_limit = 10;
            board_limit = 10;
        } else {
            page_limit = 4;
            board_limit = 5;
        }

        list_count = $("#list_count").val();
        max_page = Math.ceil(list_count / board_limit);
        start_page = parseInt((current_page - 1) / page_limit) * page_limit + 1;
        end_page = (start_page + page_limit) - 1;
        if (end_page > max_page) {
            end_page = max_page;
        }

        $("#list_count").val(list_count);
        $("#current_page").val(current_page);
        $("#page_limit").val(page_limit);
        $("#max_page").val(max_page);
        $("#start_page").val(start_page);
        $("#end_page").val(end_page);
        $("#board_limit").val(board_limit);
        /* 페이징 관련 변수 선언 끝 */


        /* 페이징html 입력 부분 */
        $("ul.pagination").children().remove();




        var $tr = jQuery('tbody tr');

        if (max_page > 1) {
            // previous버튼
            // 첫 로딩 시 prev버튼 비활성화를 위해 class='disabled' 추가
            jQuery('.pagination').append("<li class='disabled'><a id='preA'>Previous</a></li>");

            // 페이징 숫자버튼
            for (var i = start_page; i <= end_page; i++) {
                jQuery('.pagination').append("<li><a>" + i + "</a></li>");
            }

            // next버튼
            jQuery('.pagination').append("<li><a id='nextA'>Next</a></li>");

            // 버튼 세부 설정
            jQuery('.pagination a').addClass("pagination-link");
            if (current_page % board_limit == 1) {
                $(".pagination li").eq(1).addClass("active");
            }
        }

        next_btn_css();

        // 현재 페이지에 맞추어 목록 show
        $tr.each(function (i) {
            jQuery(this).hide();
            if (i + 1 <= board_limit) {
                $tr.eq(i).show();
            }
        });
        /* 페이징html 입력 부분 끝 */


        // 페이징 버튼 클릭 이벤트 시 함수 실행
        $(".pagination a").click(".pagination-link", function (e) {
            e.preventDefault();

            var go_page = $(this).text();

            var list_count = parseInt($("#list_count").val());  // 모든 목록의 수
            var current_page = parseInt($("#current_page").val());  // 현재 페이지
            var max_page = parseInt($("#max_page").val());  // 전체 페이지의 가장 마지막 페이지
            var start_page = parseInt($("#start_page").val());  // 한 페이지 하단에 보여질 시작 페이지
            var end_page = parseInt($("#end_page").val());  // 한 페이지 하단에 보여질 끝 페이지
            var board_limit = parseInt($("#board_limit").val());  // 한 페이지에 보여질 게시
            var page_limit = parseInt($("#page_limit").val());; // 한 페이지 하단에 보여질 페이지 수

            if (go_page == "Previous") {
                go_page = (parseInt(current_page) - 1) === 0 ? 1 : parseInt(current_page) - 1;
            } else if (go_page == "Next") {
                go_page = parseInt(current_page) + 1 > max_page ? max_page : parseInt(current_page) + 1;
            }

            //if (max_page == 1) go_page = 1;

            $("#current_page").val(go_page);
            current_page = parseInt($("#current_page").val());  //

            if (go_page > end_page) {
                pagination();
            }
            if (go_page < start_page) {
                pagination();
            }


            var $tr = jQuery('tbody tr');
            $tr.hide();

            var temp = go_page - 1;
            var start = temp * board_limit;
            var click_num = $(".pagination a").index(this);

            $(".pagination li").removeClass("active");
            if ($(this).text() != "Previous" && $(this).text() != "Next") {
                $(".pagination li").eq(click_num).addClass("active");
            } else {
                if (go_page % page_limit == 0) {
                    $(".pagination li").eq(go_page / (go_page / page_limit)).addClass("active");
                } else {
                    $(".pagination li").eq(go_page % page_limit).addClass("active");
                }
            }

            for (var i = 0; i < board_limit; i++) {
                $tr.eq(start + i).show();
            }


            // previous버튼 활성화/비활성화
            if (temp >= 1) {
                $(".pagination li:first-child").removeClass("disabled");

                pre_btn_css();
            } else {
                $("#preA").unbind("touchstart");
                $("#preA").unbind("touchend");

                $(".pagination li:first-child").addClass("disabled");
            }

            // next버튼 활성화/비활성화
            if (start + board_limit >= list_count) {
                $("#nextA").unbind("touchstart");
                $("#nextA").unbind("touchend");

                $(".pagination li:last-child").addClass("disabled");
            } else {
                $(".pagination li:last-child").removeClass("disabled");

                next_btn_css();
            }


        });


    }

    function fn_go_page() {
        var go_page = $("#max_page").val();

        var board_limit = parseInt($("#board_limit").val());  // 한 페이지에 보여질 게시

        var $tr = jQuery('tbody tr');
        $tr.hide();

        var temp = go_page - 1;
        var start = temp * board_limit;
        var click_num = $(".pagination a").length;

        $(".pagination li").removeClass("active");
        $(".pagination li:first-child").removeClass("disabled");
        $(".pagination li:last-child").addClass("disabled");
        $(".pagination li").eq(click_num - 2).addClass("active");

        for (var i = 0; i < board_limit; i++) {
            $tr.eq(start + i).show();
        }

        $("#current_page").val(go_page);
        current_page = $("#current_page").val();
    }

    // 페이징 next버튼 css 초기화
    function next_btn_css() {
        $("#nextA").bind({
            touchstart: function () {
                $(this).css("background-color", "#66615B");
            },
            touchend: function () {
                $(this).css("background-color", "#fff");
                $(this).css("color", "#66615B");
            }
        });
    }

    // 페이징 previous버튼 css 초기화
    function pre_btn_css() {
        $("#preA").bind({
            touchstart: function () {
                $(this).css("background-color", "#66615B");
            },
            touchend: function () {
                $(this).css("background-color", "#fff");
                $(this).css("color", "#66615B");
            }
        });
    }


</script>

</html>
