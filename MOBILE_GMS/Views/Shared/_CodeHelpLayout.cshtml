<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="76x76" href="~/Content/dashboard_bootstrap/assets/img/apple-icon.png">
    <link rel="icon" type="image/png" sizes="96x96" href="~/Content/dashboard_bootstrap/assets/img/favicon.png">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

    <title>GMS GREEN</title>

    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0' name='viewport' />
    <meta name="viewport" content="width=device-width" />
    <META HTTP-EQUIV="Pragma" CONTENT="no-cache">
    <META HTTP-EQUIV="Pragma" CONTENT="no-store">
    <META HTTP-EQUIV="Expires" CONTENT="-1">
    <META HTTP-EQUIV="Cache-Control" CONTENT="no-cache">

    <!-- Bootstrap core CSS     -->
    <link href="~/Content/dashboard_bootstrap/assets/css/bootstrap.min.css" rel="stylesheet" />

    <!--  Paper Dashboard core CSS    -->
    <link href="~/Content/dashboard_bootstrap/assets/css/paper-dashboard.css" rel="stylesheet" />


    <!--  CSS for Demo Purpose, don't include it in your project     -->
    <link href="~/Content/dashboard_bootstrap/assets/css/demo.css" rel="stylesheet" />


    <!--  Fonts and icons     -->
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" rel="stylesheet">
    <link href='https://fonts.googleapis.com/css?family=Muli:400,300' rel='stylesheet' type='text/css'>
    <link href="~/Content/dashboard_bootstrap/assets/css/themify-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <div class="navbar-brand">공통코드조회-@Model.srchTitle</div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--   Core JS Files. Extra: TouchPunch for touch library inside jquery-ui.min.js   -->
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery.min.js" type="text/javascript"></script>
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery-ui.min.js" type="text/javascript"></script>
    <script src="~/Content/dashboard_bootstrap/assets/js/perfect-scrollbar.min.js" type="text/javascript"></script>
    <script src="~/Content/dashboard_bootstrap/assets/js/bootstrap.min.js" type="text/javascript"></script>

    <!--  Forms Validations Plugin -->
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery.validate.min.js"></script>

    <!-- Promise Library for SweetAlert2 working on IE -->
    <script src="~/Content/dashboard_bootstrap/assets/js/es6-promise-auto.min.js"></script>

    <!--  Plugin for Date Time Picker and Full Calendar Plugin-->
    <script src="~/Content/dashboard_bootstrap/assets/js/moment.min.js"></script>

    <!--  Date Time Picker Plugin is included in this js file -->
    <script src="~/Content/dashboard_bootstrap/assets/js/bootstrap-datetimepicker.js"></script>

    <!--  Select Picker Plugin -->
    <script src="~/Content/dashboard_bootstrap/assets/js/bootstrap-selectpicker.js"></script>

    <!--  Switch and Tags Input Plugins -->
    <script src="~/Content/dashboard_bootstrap/assets/js/bootstrap-switch-tags.js"></script>

    <!-- Circle Percentage-chart -->
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery.easypiechart.min.js"></script>

    <!--  Notifications Plugin    -->
    <script src="~/Content/dashboard_bootstrap/assets/js/bootstrap-notify.js"></script>

    <!-- Sweet Alert 2 plugin -->
    <script src="~/Content/dashboard_bootstrap/assets/js/sweetalert2.js"></script>

    <!-- Vector Map plugin -->
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery-jvectormap.js"></script>

    <!--  Google Maps Plugin    -->
    <!-- <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_KEY_HERE"></script> -->
    <!-- Wizard Plugin    -->
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery.bootstrap.wizard.min.js"></script>

    <!--  Bootstrap Table Plugin    -->
    <script src="~/Content/dashboard_bootstrap/assets/js/bootstrap-table.js"></script>

    <!--  Plugin for DataTables.net  -->
    <script src="~/Content/dashboard_bootstrap/assets/js/jquery.datatables.js"></script>

    <!--  Full Calendar Plugin    -->
    <script src="~/Content/dashboard_bootstrap/assets/js/fullcalendar.min.js"></script>

    <!-- Paper Dashboard PRO Core javascript and methods for Demo purpose -->
    <script src="~/Content/dashboard_bootstrap/assets/js/paper-dashboard.js"></script>

    <!-- Paper Dashboard PRO DEMO methods, don't include it in your project! -->
    <script src="~/Content/dashboard_bootstrap/assets/js/demo.js"></script>
</body>
</html>
