<environment names="Development">
    <link rel="stylesheet" href="~/css/gms_01.css" />
    <script src="~/Content/Login_v2/vendor/jquery/jquery-3.2.1.min.js"></script>
</environment>


<div class="content">
    <div class="container-fluid padding-rl-del">
        <div class="row margin-rl-del">

            <div class="col-md-12 padding-rl-del">
                <div class="card margin-bottom-0">

                    <form class="form-horizontal" id="myForm" name="myForm">
                        <div class="card-header">
                            <h4 class="card-title">
                                완제품 기타 입고
                            </h4>
                        </div>

                        <div class="card-content">
                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">바코드</label>
                                    <div class="col-sm-10" id="mobile_object" style="display:none">

                                        <input type="text" id="barcode_val" class="form-control" name="mobile_object" readonly="readonly" />

                                    </div>
                                    <div class="col-sm-10" id="pc_object" style="display:none">

                                        <input type="text" id="barcode_val" class="form-control" name="pc_object" onkeydown="onKeyDown();" onfocus="setBarcodeInit()" />

                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">품목코드</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="item_cd" name="item_cd" class="input-css" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">품목명</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="item_nm" name="item_nm" class="input-css" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">제조번호</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="lot_no" name="lot_no" class="input-css" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">출하상태</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="issue_status_nm" name="issue_status_nm" class="input-css" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">재고량</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="stock_qty" name="stock_qty" class="input-css" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">단위</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="keeping_unit" name="keeping_unit" class="input-css" readonly="readonly" />
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <hr />
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">입고구분</label>
                                    <div class="col-sm-10">
                                        <select name="dv_cb" id="dv_cb" class="input-css"></select>
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">입고량</label>
                                    <div class="col-sm-10">
                                        <input id="nud_in_qty" name="nud_in_qty" type="text" class="input-lg input-css" value="0" data-bts-min="0" data-bts-max="100000000" data-bts-init-val="" data-bts-step="1" data-bts-decimal="0" style="margin-left:1px;text-align:center;">
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">입고일자</label>
                                    <div class="col-sm-10">
                                        <div class="form-group">
                                            <div class="col-sm-4">
                                                <div class="input-group">
                                                    <select name="od_date_year" id="od_date_year" class="input-css">
                                                        <option selected="" disabled="">- 년 도 선 택 -</option>
                                                        @for (var i = currentYear; i >= 1990; i--)
                                                        {
                                                            <option value="@i">@i</option>

                                                        }
                                                    </select>

                                                    <span class="input-group-addon">년</span>
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="input-group">
                                                    <select name="od_date_month" id="od_date_month" class="input-css">
                                                        <option selected="" disabled="">- 월 선 택 -</option>
                                                        @for (var m = 1; m <= 12; m++)
                                                        {
                                                            <option value="@m">@m</option>

                                                        }
                                                    </select>
                                                    <span class="input-group-addon">월</span>
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="input-group">
                                                    <select name="od_date_day" id="od_date_day" class="input-css">
                                                        <option selected="" disabled="">- 일 선 택 -</option>
                                                        @for (var d = 1; d <= 31; d++)
                                                        {
                                                            <option value="@d">@d</option>
                                                        }
                                                    </select>
                                                    <span class="input-group-addon">일</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <label class="col-sm-2 control-label" style="margin-bottom: auto; font-size : 18px">비고</label>
                                    <div class="col-sm-10">
                                        <textarea class="form-control" id="dv_tb" name="dv_tb" rows="3"></textarea>
                                    </div>
                                </div>
                            </fieldset>

                            <fieldset>
                                <div class="form-group has-success">
                                    <div class="col-sm-12">
                                        <button id="btn_in" type="button" class="btn btn-default btn-lg pull-right" onclick="javascript:fn_save()">입 고</button>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </form>

                </div>  <!-- end card -->
            </div> <!-- end col-md-12 -->
        </div> <!-- end row -->
    </div>

</div>


<!--===============================================================================================-->
<script src="~/Content/Table_Fixed_Header/vendor/jquery/jquery-3.2.1.min.js"></script>
