<script src="~/Content/Table_Fixed_Header/js/main.js"></script>

<script src="https://kendo.cdn.telerik.com/2020.2.513/js/kendo.all.min.js"></script>

<script type="text/javascript">

    $(document).ready(function () {
        // 모바일 기기 체크
        fn_moblieCK();

        var now = new Date();

        //https://www.jqueryscript.net/form/Touch-Friendly-jQuery-Input-Spinner-Plugin-For-Bootstrap-3-TouchSpin.html
        //https://www.jqueryscript.net/demo/Touch-Friendly-jQuery-Input-Spinner-Plugin-For-Bootstrap-3-TouchSpin/
        // 참조
        $("input[name='nud_in_qty']").TouchSpin({});

        // 공통 코드 호출
        var params = { 'gb': '공통코드', 'div': 'N', 'strwhere': 'GD201' }
        fn_commonCd(params);
    });

    // 바코드 초기화 (웹 환경에서 사용됨)
    function setBarcodeInit() {

        $('#barcode_val').val('');

    }

    // 엔터키 동작 (웹 환경에서 사용됨)
    function onKeyDown() {

        // 엔터키 코드
        if (event.keyCode == 13) {

            var barcode = $("#barcode_val").val();

            // 포커스 해제
            $("#barcode_val").blur();

            fn_callBarcodeInfo({ 'barcode': barcode.replaceAll("\0", "") });

        }

    }


    /*
     * 바코드관련 상세 정보 호출
     * (창고,구역,셀 정보)
     */
    function fn_callBarcodeInfo(params) {

        // 폼 초기화
        $("#myForm").find('input[type="text"], textarea, select').val('');
        $("#myForm").find('input[type="checkbox"]').prop('checked', false);
        $("#dv_cb").val("");
        $("#nud_in_qty").val("0");
        $("#issue_status_nm").css("background-color", "");
        $("#issue_status_nm").css("color", "");
        //
        var barcode = params.barcode.replaceAll("\0", "");
        $("#barcode_val").val(barcode);

        var callUrl = "/ProductEtcIn/ProductEtcInSearch";
        var _params = {
            'barcode': barcode
        }

        var request = JSON.stringify(_params);
        $.ajax({
            method: "POST",
            data: request,
            url: callUrl,
            dataType: 'json',
            contentType: 'application/json; charset=UTF-8',
            success: function (data) {

                $("#item_cd").val(data.item_cd);
                $("#item_nm").val(data.item_nm);
                $("#lot_no").val(data.lot_no);
                $("#issue_status_nm").val(data.issue_status_nm);
                $("#stock_qty").val(data.stock_qty);
                $("#keeping_unit").val(data.keeping_unit);
                fn_setStatusColor(data.issue_status);

            },
            error: function (data) {
                btnEnableFlag1 = 0;
                alert('error' + data.status);
            }
        });

    }

    /*
     * 출하 상태 색상 처리
     **/
    function fn_setStatusColor(issueStatus) {

        if (issueStatus == "1" || issueStatus == "2") {     //의뢰
            $("#issue_status_nm").css("background-color", "yellow");
            $("#issue_status_nm").css("color", "black");
        } else if (issueStatus == "3") {     //검토
            $("#issue_status_nm").css("background-color", "white");
            $("#issue_status_nm").css("color", "black");
        } else if (issueStatus == "4") {     //승인
            $("#issue_status_nm").css("background-color", "green");
            $("#issue_status_nm").css("color", "white");
        }
    }

    function fn_formCheck() {

        // 바코드 정보 입력 여부 확인.
        var barcode = $("#barcode_val").val();
        if (typeof barcode == "undefined" || barcode == null || barcode == "") {

            swal({
                title: '기타 입고할 바코드 정보를 입력해 주세요.',
                type: 'error'
            });

            //기타 입고할 정보를 입력해 주세요
            return false;
        }

        // 바코드 정보 입력 여부 확인.
        var item_cd = $("#item_cd").val();
        if (typeof item_cd == "undefined" || item_cd == null || item_cd == "") {

            swal({
                title: '기타 입고할 품목 코드 정보를 입력해 주세요.',
                type: 'error'
            });
            return false;
        }

        // 입고구분
        var dv_cb = $("#dv_cb").val();
        if (typeof dv_cb == "undefined" || dv_cb == null || dv_cb == "") {

            swal({
                title: '입고구분을 선택해주세요.',
                type: 'error'
            });
            return false;
        }

        // 재고량 확인
        var nud_in_qty = $("#nud_in_qty").val();
        if (typeof nud_in_qty == "undefined" || nud_in_qty == null || nud_in_qty == "" || parseInt(nud_in_qty) <= 0) {

            swal({
                title: '수량[입고량]을 입력해 주세요.',
                type: 'error'
            });
            return false;
        }
        // 입고일자 확인
        var od_date_year = $("#od_date_year").val();
        var od_date_month = $("#od_date_month").val();
        var od_date_day = $("#od_date_day").val();

        if ((typeof od_date_year == "undefined" || od_date_year == null || od_date_year == "")
            ||
            (typeof od_date_month == "undefined" || od_date_month == null || od_date_month == "")
            ||
            (typeof od_date_day == "undefined" || od_date_day == null || od_date_day == "")
        ) {
            swal({
                title: '입고일자를 선택해주세요.',
                type: 'error'
            });
            return false;
        }

        //var od_in_date = $("#od_in_date").val();
        //if (typeof od_in_date == "undefined" || od_in_date == null || od_in_date == "") {

        //    swal({
        //        title: '입고일자를 입력해주세요.',
        //        type: 'error'
        //    });
        //    return false;
        //}

        return true;
    }

    function fn_save() {

        if (fn_formCheck()) {
            if (confirm("입고처리하시겠습니까?")) {

                var barcode = $("#barcode_val").val();
                barcode = barcode.replaceAll("\0", "");

                var in_type = $("#dv_cb").val();
                var in_qty = $("#nud_in_qty").val();
                //var in_date = $("#od_in_date").val();
                var in_remark = $("#dv_tb").val();

                var od_date_year = $("#od_date_year").val();
                var od_date_month = $("#od_date_month").val();
                var od_date_day = $("#od_date_day").val();
                var in_date = od_date_year + "-" + od_date_month + "-" + od_date_day;

                var params = { 'barcode': barcode, 'in_type': in_type, 'in_qty': in_qty, 'in_date': in_date, 'in_remark': in_remark };
                var callUrl = "/ProductEtcIn/SaveProductEtcIn";

                var request = JSON.stringify(params);
                $.ajax({
                    method: "POST",
                    data: request,
                    url: callUrl,
                    dataType: 'json',
                    contentType: 'application/json; charset=UTF-8',
                    success: function (data) {

                        if (data.result == '1') {
                            swal({
                                //title: 'Success!',
                                title: '정상적으로 처리되었습니다.',
                                type: 'success'
                                //timer: 1000
                            }
                            ).then(
                                function () {

                                    // 재 호출
                                    fn_callBarcodeInfo({ 'barcode': barcode });
                                }
                            );
                        } else {

                            swal({
                                title: '처리 중 에러가 발생하였습니다.',
                                type: 'error'
                            });
                            return false;
                        }
                    },
                    error: function (data) {
                        alert('error' + data.status);
                    }
                });


            } else {
                return;
            }
        }
    }

    /*
     * 공통 코드 데이터를 활용한 화면 셋팅
     */
    function fn_commonCdSet(data) {

        $('#dv_cb').empty();
        if (data.length > 0) {
            $('#dv_cb').append('<option selected="" disabled="">- 선 택 -</option>');
            for (var count = 0; count < data.length; count++) {
                var option = $("<option value='" + data[count].keyfield + "'>" + data[count].displayfield + "</option>");
                $('#dv_cb').append(option);
            }
        }
    }
</script>