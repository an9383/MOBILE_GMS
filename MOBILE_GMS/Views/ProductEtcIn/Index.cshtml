
@{
    ViewData["Title"] = "PackSelect";
    Layout = "~/Views/Shared/_GmsLayout.cshtml";

    int currentYear = DateTime.Now.Year;
    string currentMonth = "0" + DateTime.Now.Month.ToString();
    string currentDay = "0" + DateTime.Now.Day.ToString();

    currentMonth = currentMonth.Substring(currentMonth.Length - 2);
    currentDay = currentDay.Substring(currentDay.Length - 2);

}


<!--===============================================================================================-->
<link rel="stylesheet" type="text/css" href="~/Content/Table_Fixed_Header/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
<!--===============================================================================================-->
